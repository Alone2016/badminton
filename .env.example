# Copy file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# --- Web (bắt buộc) ---
# Supabase Dashboard > Project Settings > API Keys (hoặc nút "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) hoặc anon key (legacy). Đây là khóa công khai, an toàn khi lộ ra trình duyệt.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase CLI (chỉ cần ở máy khi chạy migration, KHÔNG đưa lên Vercel) ---
# Supabase Dashboard > Account > Access Tokens
SUPABASE_ACCESS_TOKEN=
# Mật khẩu database đặt lúc tạo project (Project Settings > Database để đặt lại)
SUPABASE_DB_PASSWORD=
